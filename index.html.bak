      <a href="#about" class="overlay-link">About</a>
      <a href="#projects" class="overlay-link">Projects</a>
      <a href="#timeline" class="overlay-link">Timeline</a>
      <a href="#skills" class="overlay-link">Skills</a>
      <a href="#activities" class="overlay-link">Activities</a>
    </div>
  </div>

  <!-- ===== HERO ===== -->
  <section id="hero">
    <div class="hero-content">
      <img src="https://media.licdn.com/dms/image/v2/D5603AQG5X1p3Z4y-Kw/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1727863581815?e=1749686400&v=beta&t=0ZJasB1aQVPIFx9lyWWmQ41mF8HgKLITqNoqK_OI1qQ" alt="Amir Jamal Ali Khan"
        onerror="this.style.display='none'; document.getElementById('hero-monogram').style.display='flex';"
        class="hero-avatar" />
      <div id="hero-monogram" class="hero-avatar-monogram">JA</div>
      <div class="hero-badge animate-on-scroll" style="transition-delay:0s">AI Engineer / Flutter Developer &commat; SpeedForce Digital</div>
      <h1 class="hero-name animate-on-scroll" style="transition-delay:0.1s">Amir Jamal Ali Khan</h1>
      <div class="hero-typewriter animate-on-scroll" style="transition-delay:0.2s">
        <span class="typewriter-wrap">
          <span id="typewriterText"></span>
        </span>
      </div>
      <div class="hero-buttons animate-on-scroll" style="transition-delay:0.3s">
        <a href="#projects" class="btn-primary">
          View My Work
          <i data-lucide="arrow-down" style="width:16px;height:16px"></i>
        </a>
        <a href="#reports" class="btn-secondary">
          Download ABCD Reports
          <i data-lucide="file-text" style="width:16px;height:16px"></i>
        </a>
      </div>
    </div>
    <div class="scroll-indicator">
      <i data-lucide="chevron-down" style="width:24px;height:24px"></i>
    </div>
  </section>

  <!-- ===== STATS ===== -->
  <section id="stats">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card animate-on-scroll">
          <span class="stat-number" data-target="5" data-suffix="+">0</span>
          <span class="stat-label">Production Projects Delivered</span>
        </div>
        <div class="stat-card animate-on-scroll" style="transition-delay:0.1s">
          <span class="stat-number" data-target="300" data-suffix="+">0</span>
          <span class="stat-label">Screens Designed &amp; Redesigned</span>
        </div>
        <div class="stat-card animate-on-scroll" style="transition-delay:0.2s">
          <span class="stat-number" data-target="1000" data-suffix="+">0</span>
          <span class="stat-label">Localization Keys (EN/AR)</span>
