        <a href="#skills">Skills</a>
        <a href="#activities">Activities</a>
      </div>
      <div style="display:flex;align-items:center;gap:12px">
        <button id="themeToggle" aria-label="Toggle theme" style="background:none;border:none;cursor:pointer;color:var(--color-text-muted);padding:4px;display:flex;transition:color 0.25s" onmouseover="this.style.color='var(--color-orange)'" onmouseout="this.style.color='var(--color-text-muted)'">
          <i data-lucide="moon" id="themeIcon" style="width:18px;height:18px"></i>
        </button>
        <button class="nav-hamburger" id="hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile overlay -->
  <div class="nav-overlay" id="navOverlay">
