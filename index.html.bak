<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Amir Jamal Ali Khan — Achievement Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --color-navy: #0D1B2A;
      --color-navy-mid: #142233;
      --color-navy-light: #1C2F45;
      --color-orange: #FF7A1A;
      --color-orange-dim: rgba(255, 122, 26, 0.12);
      --color-white: #FFFFFF;
      --color-off-white: #F4F6F9;
      --color-text-muted: #8A9BB0;
      --color-divider: rgba(255, 255, 255, 0.08);
      --font-display: 'Syne', sans-serif;
      --font-body: 'DM Sans', sans-serif;
      --section-padding: 100px 0;
      --container-width: 1140px;
      --radius-card: 16px;
      --radius-pill: 100px;
      --code-class: #7EC8E3;
      --code-string: #A8D5A2;
      --code-comment: #5A6F84;
    }
    [data-theme="light"] {
      --color-navy: #FFFFFF;
      --color-navy-mid: #F4F6F9;
      --color-navy-light: #FFFFFF;
      --color-white: #0D1B2A;
      --color-text-muted: #6B7F94;
      --color-divider: rgba(0, 0, 0, 0.08);
      --color-orange-dim: rgba(255, 122, 26, 0.08);
    }
    [data-theme="light"] nav,
    [data-theme="light"] .nav-overlay {
      background: rgba(255, 255, 255, 0.85);
    }
    [data-theme="light"] .nav-hamburger span {
      background: var(--color-white);
    }
    [data-theme="light"] .timeline-dot {
      border-color: var(--color-navy);
    }
    [data-theme="light"] .timeline-dot-mobile {
      border-color: var(--color-navy);
    }
    [data-theme="light"] .culture-card-bg-overlay {
      background: rgba(255, 255, 255, 0.75);
    }
    [data-theme="light"] .hero-name,
    [data-theme="light"] .project-title,
    [data-theme="light"] .timeline-title,
    [data-theme="light"] .culture-title,
    [data-theme="light"] .footer-name,
    [data-theme="light"] .section-heading,
    [data-theme="light"] .skills-category h4,
    [data-theme="light"] .abcd-achievement,
    [data-theme="light"] .project-stats-row span,
    [data-theme="light"] .btn-secondary {
      color: var(--color-white);
    }
    [data-theme="light"] .btn-secondary {
      border-color: var(--color-divider);
    }
    [data-theme="light"] .project-stats-row span {
      background: rgba(255, 122, 26, 0.08);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      background: var(--color-navy);
      color: var(--color-white);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    .container {
      width: 100%;
      max-width: var(--container-width);
      margin: 0 auto;
      padding: 0 20px;
    }
    section { padding: var(--section-padding); }

    /* ===== ANIMATION SYSTEM ===== */
    .animate-on-scroll {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .animate-on-scroll.visible { opacity: 1; transform: translateY(0); }
    .animate-on-scroll:nth-child(1) { transition-delay: 0.0s; }
    .animate-on-scroll:nth-child(2) { transition-delay: 0.1s; }
    .animate-on-scroll:nth-child(3) { transition-delay: 0.2s; }
    .animate-on-scroll:nth-child(4) { transition-delay: 0.3s; }
    .animate-on-scroll:nth-child(5) { transition-delay: 0.4s; }
    .animate-on-scroll:nth-child(6) { transition-delay: 0.5s; }

    /* ===== SECTION LABELS ===== */
    .section-label {
      font: 600 11px/1 var(--font-display);
      color: var(--color-orange);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 12px;
    }
    .section-heading {
      font: 700 32px/1.2 var(--font-display);
      color: var(--color-white);
      margin-bottom: 40px;
    }
    @media (min-width: 768px) {
      .section-heading { font-size: 48px; }
    }

    /* ===== NAV ===== */
    nav {
      position: fixed; top: 0; width: 100%; z-index: 100;
      background: rgba(13, 27, 42, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--color-divider);
      padding: 20px 0;
      transition: padding 0.3s ease;
    }
    nav.scrolled { padding: 14px 0; }
    .nav-inner {
      display: flex; align-items: center; justify-content: space-between;
      max-width: var(--container-width); margin: 0 auto; padding: 0 20px;
    }
    .nav-left { display: flex; align-items: center; gap: 12px; }
    .nav-avatar-img {
      width: 36px; height: 36px; border-radius: 50%;
      object-fit: cover; border: 2px solid var(--color-orange);
    }
    .nav-avatar-monogram {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--color-orange); color: var(--color-white);
      font: 700 14px/1 var(--font-display);
      display: none; align-items: center; justify-content: center;
      border: 2px solid var(--color-orange);
    }
    .nav-links { display: none; gap: 28px; align-items: center; }
    .nav-links a {
      font: 500 13px/1 var(--font-body);
      color: var(--color-text-muted);
      transition: color 0.25s ease; letter-spacing: 0.02em;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--color-orange); }
    .nav-hamburger {
      display: flex; flex-direction: column; gap: 5px; cursor: pointer;
      background: none; border: none; padding: 4px; z-index: 101;
    }
    .nav-hamburger span {
      display: block; width: 22px; height: 2px;
      background: var(--color-white); border-radius: 2px;
      transition: all 0.3s ease;
    }
    .nav-hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
    .nav-hamburger.active span:nth-child(2) { opacity: 0; }
    .nav-hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }
    @media (min-width: 1024px) {
      .nav-links { display: flex; }
      .nav-hamburger { display: none; }
    }

    /* Mobile overlay */
    .nav-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: var(--color-navy);
      z-index: 99; display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }
    .nav-overlay.open { opacity: 1; visibility: visible; }
    .nav-overlay-links { display: flex; flex-direction: column; gap: 32px; text-align: center; }
    .nav-overlay-links a {
      font: 600 24px/1 var(--font-display);
      color: var(--color-white);
      transition: color 0.25s;
    }
    .nav-overlay-links a:hover { color: var(--color-orange); }

    /* ===== HERO ===== */
    #hero {
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
      text-align: center; position: relative; overflow: hidden;
      padding-top: 80px;
    }
    #hero::before {
      content: '';
      position: absolute; inset: 0;
      opacity: 0.04;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
      background-repeat: repeat; background-size: 256px 256px;
      pointer-events: none;
    }
    #hero::after {
      content: ''; position: absolute; bottom: 80px; right: 10%;
      width: 200px; height: 2px;
      background: var(--color-orange);
      transform: rotate(-15deg); opacity: 0.3;
      pointer-events: none;
    }
    .hero-content { position: relative; z-index: 1; max-width: 720px; padding: 0 20px; }
    .hero-avatar {
      width: 80px; height: 80px; border-radius: 50%;
      border: 3px solid var(--color-orange);
      box-shadow: 0 0 0 6px rgba(255, 122, 26, 0.15);
      object-fit: cover; margin: 0 auto 20px;
    }
    .hero-avatar-monogram {
      width: 80px; height: 80px; border-radius: 50%;
      background: var(--color-orange); color: var(--color-white);
      font: 800 32px/1 var(--font-display);
      display: none; align-items: center; justify-content: center;
      margin: 0 auto 20px; border: 3px solid var(--color-orange);
      box-shadow: 0 0 0 6px rgba(255, 122, 26, 0.15);
    }
    @media (min-width: 768px) {
      .hero-avatar, .hero-avatar-monogram { width: 88px; height: 88px; }
      .hero-avatar-monogram { font-size: 32px; }
    }
    .hero-badge {
      display: inline-block;
      padding: 8px 20px;
      background: var(--color-orange-dim);
      color: var(--color-orange);
      border-radius: var(--radius-pill);
      font: 600 12px/1 var(--font-body);
      margin-bottom: 20px;
      letter-spacing: 0.03em;
    }
    .hero-name {
      font: 800 40px/1.1 var(--font-display);
      color: var(--color-white);
      margin-bottom: 16px;
      white-space: nowrap;
    }
    @media (min-width: 768px) {
      .hero-name { font-size: 56px; }
    }
    @media (min-width: 1024px) {
      .hero-name { font-size: 64px; }
    }
    .hero-typewriter {
      font: 500 16px/1.6 var(--font-body);
      color: var(--color-text-muted);
      min-height: 52px;
      margin-bottom: 32px;
    }
    @media (min-width: 768px) {
      .hero-typewriter { font-size: 18px; }
    }
    .typewriter-wrap {
      display: inline-block;
      position: relative;
    }
    .typewriter-wrap::after {
      content: '|';
      color: var(--color-orange);
      animation: blink 0.7s step-end infinite;
    }
    @keyframes blink {
      50% { opacity: 0; }
    }
    #typewriterText {
      display: inline;
      min-height: 1.6em;
    }
    .hero-buttons {
      display: flex; flex-wrap: wrap; gap: 16px; justify-content: center;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 14px 32px;
      background: var(--color-orange); color: var(--color-white);
      border-radius: var(--radius-pill);
      font: 600 14px/1 var(--font-body);
      border: none; cursor: pointer;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(255,122,26,0.3); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 14px 32px;
      background: transparent; color: var(--color-white);
      border: 1px solid var(--color-divider);
      border-radius: var(--radius-pill);
      font: 600 14px/1 var(--font-body);
      cursor: pointer;
      transition: border-color 0.25s ease, transform 0.25s ease;
    }
    .btn-secondary:hover { border-color: var(--color-orange); transform: translateY(-2px); }
    .scroll-indicator {
      position: absolute; bottom: 32px; left: 50%;
      transform: translateX(-50%);
      color: var(--color-text-muted);
      animation: bounceArrow 2s ease infinite;
    }
    @keyframes bounceArrow {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(8px); }
    }

    /* ===== STATS ===== */
    #stats { background: var(--color-navy-mid); }
    .stats-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;
    }
    @media (min-width: 768px) {
      .stats-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .stat-card {
      padding: 28px 20px;
      background: var(--color-navy-light);
      border: 1px solid var(--color-divider);
      border-radius: var(--radius-card);
      text-align: center; position: relative; overflow: hidden;
    }
    @media (min-width: 768px) {
      .stat-card { padding: 40px 32px; }
    }
    .stat-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: var(--color-orange);
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.6s ease;
    }
    .stat-card:hover::before { transform: scaleX(1); }
    .stat-number {
      font: 800 36px/1 var(--font-display);
      color: var(--color-orange); display: block; margin-bottom: 8px;
    }
    @media (min-width: 768px) {
      .stat-number { font-size: 56px; }
    }
    .stat-label {
      font: 500 12px/1.4 var(--font-body);
      color: var(--color-text-muted);
      text-transform: uppercase; letter-spacing: 0.08em;
    }
    @media (min-width: 768px) {
      .stat-label { font-size: 14px; }
    }

    /* ===== ABOUT ===== */
    #about { background: var(--color-navy); }
    .about-grid {
      display: grid; grid-template-columns: 1fr; gap: 40px;
      align-items: start;
    }
    @media (min-width: 1024px) {
      .about-grid { grid-template-columns: 1fr 1fr; }
    }
    .about-text p {
      font: 400 15px/1.8 var(--font-body);
      color: var(--color-text-muted);
      margin-bottom: 20px;
    }
    @media (min-width: 768px) {
      .about-text p { font-size: 16px; }
    }
    .about-highlights {
      list-style: none; margin-top: 16px;
    }
    .about-highlights li {
      font: 400 14px/1.6 var(--font-body);
      color: var(--color-text-muted);
      padding-left: 20px; position: relative; margin-bottom: 8px;
    }
    .about-highlights li::before {
      content: ''; position: absolute; left: 0; top: 8px;
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--color-orange);
    }
    .about-code-card {
      padding: 32px 28px;
      background: var(--color-navy-light);
      border: 1px solid var(--color-divider);
      border-radius: var(--radius-card);
      font-family: 'DM Sans', monospace;
      font-size: 13px; line-height: 1.8;
      color: var(--color-text-muted);
      overflow-x: auto;
    }
    .about-code-card .code-keyword { color: var(--color-orange); }
    .about-code-card .code-class { color: var(--code-class); }
    .about-code-card .code-string { color: var(--code-string); }
    .about-code-card .code-comment { color: var(--code-comment); font-style: italic; }

    /* ===== PROJECTS ===== */
    #projects { background: var(--color-navy-mid); }
    .project-card-large {
      display: grid; grid-template-columns: 1fr; gap: 32px;
      align-items: center; padding: 32px 24px;
      background: var(--color-navy-light);
      border: 1px solid var(--color-divider);
      border-radius: 24px; margin-bottom: 24px;
      transition: border-color 0.3s ease, transform 0.3s ease;
    }
    @media (min-width: 1024px) {
      .project-card-large {
        grid-template-columns: 1fr 1fr; gap: 60px;
        padding: 60px; margin-bottom: 32px;
      }
      .project-card-large.reversed { direction: rtl; }
      .project-card-large.reversed > * { direction: ltr; }
    }
    .project-card-large:hover {
      border-color: rgba(255, 122, 26, 0.3);
      transform: translateY(-4px);
    }
    .project-card-large .project-image {
      border-radius: 16px; overflow: hidden;
      background: var(--color-navy-mid);
      aspect-ratio: 16/10; display: flex; align-items: center; justify-content: center;
    }
    .project-card-large .project-image img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .project-tag {
      display: inline-block; padding: 4px 12px;
      background: var(--color-orange-dim); color: var(--color-orange);
      border-radius: var(--radius-pill);
      font: 600 11px/1.6 var(--font-body); margin-bottom: 12px;
    }
    .project-title {
      font: 700 22px/1.3 var(--font-display);
      color: var(--color-white); margin-bottom: 6px;
    }
    @media (min-width: 768px) {
      .project-title { font-size: 28px; }
    }
    .project-subhead {
      font: 500 15px/1.4 var(--font-body);
      color: var(--color-orange); margin-bottom: 16px;
    }
    .project-desc {
      font: 400 14px/1.7 var(--font-body);
      color: var(--color-text-muted); margin-bottom: 16px;
    }
    .project-features { margin-bottom: 16px; }
    .project-stats-row {
      display: flex; flex-wrap: wrap; gap: 16px;
      font: 600 13px/1 var(--font-body);
      color: var(--color-white); margin-bottom: 16px;
    }
    .project-stats-row span {
      padding: 6px 14px;
      background: var(--color-orange-dim);
      border-radius: var(--radius-pill);
    }
    .project-link {
      font: 600 13px/1 var(--font-body);
      color: var(--color-orange);
      display: inline-flex; align-items: center; gap: 6px;
      transition: gap 0.25s;
    }
    .project-link:hover { gap: 10px; }

    .project-cards-small {
      display: grid; grid-template-columns: 1fr; gap: 20px;
    }
    @media (min-width: 768px) {
      .project-cards-small { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .project-cards-small { grid-template-columns: repeat(3, 1fr); }
    }
    .project-card-small {
      padding: 28px 24px;
      background: var(--color-navy-light);
      border: 1px solid var(--color-divider);
      border-radius: var(--radius-card);
      transition: border-color 0.3s, transform 0.3s;
    }
    @media (min-width: 768px) {
      .project-card-small { padding: 36px 28px; }
    }
    .project-card-small:hover {
      border-color: rgba(255, 122, 26, 0.3);
      transform: translateY(-4px);
    }
    .project-card-small .project-image-small {
      width: 100%; height: 160px;
      background: var(--color-navy-mid);
      border-radius: 12px; margin-bottom: 16px;
      display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .project-card-small .project-image-small img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .feature-pill {
      display: inline-block; padding: 4px 12px;
      background: var(--color-orange-dim); color: var(--color-orange);
      border-radius: var(--radius-pill);
      font: 600 11px/1.6 var(--font-body); margin: 3px;
    }

    /* ===== TIMELINE ===== */
    #timeline { background: var(--color-navy); }
    .timeline-wrapper { position: relative; }
    .timeline-line {
      display: none;
    }
    @media (min-width: 768px) {
      .timeline-line {
        display: block;
        position: absolute; top: 0; bottom: 0; left: 50%;
        width: 1px; background: var(--color-divider); transform: translateX(-50%);
      }
    }
    .timeline-item {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0; align-items: start; margin-bottom: 32px;
      position: relative; padding-left: 32px;
    }
    @media (min-width: 768px) {
      .timeline-item {
        grid-template-columns: 1fr 60px 1fr;
        margin-bottom: 48px; padding-left: 0;
      }
      .timeline-item:nth-child(even) .timeline-card { grid-column: 3; }
      .timeline-item:nth-child(even) .timeline-spacer { grid-column: 1; }
    }
    .timeline-dot {
      display: none;
    }
    @media (min-width: 768px) {
      .timeline-dot {
        display: block;
        width: 16px; height: 16px; border-radius: 50%;
        background: var(--color-orange);
        border: 3px solid var(--color-navy);
        box-shadow: 0 0 0 4px rgba(255, 122, 26, 0.25);
        margin: 20px auto 0; position: relative; z-index: 1;
      }
    }
    @media (max-width: 767px) {
      .timeline-dot-mobile {
        position: absolute; left: 0; top: 22px;
        width: 12px; height: 12px; border-radius: 50%;
        background: var(--color-orange);
        border: 2px solid var(--color-navy);
        box-shadow: 0 0 0 3px rgba(255, 122, 26, 0.25);
      }
      .timeline-item::before {
        content: ''; position: absolute; left: 5px; top: 0; bottom: -16px;
        width: 1px; background: var(--color-divider);
      }
      .timeline-item:last-child::before { display: none; }
    }
    .timeline-card {
      padding: 24px 20px;
      background: var(--color-navy-light);
      border: 1px solid var(--color-divider);
      border-radius: var(--radius-card);
      transition: border-color 0.3s;
    }
    @media (min-width: 768px) {
      .timeline-card { padding: 28px 32px; }
    }
    .timeline-card:hover { border-color: rgba(255, 122, 26, 0.4); }
    .timeline-month {
      font: 700 12px/1 var(--font-display);
      color: var(--color-orange); text-transform: uppercase;
      letter-spacing: 0.1em; margin-bottom: 8px;
    }
    .timeline-title {
      font: 700 18px/1.3 var(--font-display);
      color: var(--color-white); margin-bottom: 10px;
    }
    .timeline-body {
      font: 400 14px/1.7 var(--font-body);
      color: var(--color-text-muted);
    }

    /* ===== SKILLS ===== */
    #skills { background: var(--color-navy-mid); }
    .skills-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;
    }
    @media (min-width: 1024px) {
      .skills-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .skills-category h4 {
      font: 600 14px/1 var(--font-display);
      color: var(--color-white);
      text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 16px; padding-bottom: 12px;
      border-bottom: 1px solid var(--color-divider);
    }
    .skill-pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 16px; margin: 4px;
      border: 1px solid var(--color-divider);
      border-radius: var(--radius-pill);
      font: 500 13px/1 var(--font-body);
      color: var(--color-text-muted);
      transition: all 0.25s ease; cursor: default;
    }
    .skill-pill:hover {
      background: var(--color-orange-dim);
      border-color: var(--color-orange);
      color: var(--color-orange);
    }
    .skill-pill i { width: 14px; height: 14px; stroke-width: 1.5; }

    /* ===== ACTIVITIES ===== */
    #activities { background: var(--color-navy); }
    .culture-grid {
      display: grid; grid-template-columns: 1fr; gap: 20px;
    }
    @media (min-width: 768px) {
      .culture-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .culture-card {
      padding: 28px 24px;
      background: var(--color-navy-light);
      border: 1px solid var(--color-divider);
      border-radius: var(--radius-card);
      position: relative; overflow: hidden;
    }
    @media (min-width: 768px) {
      .culture-card { padding: 36px 32px; }
    }
    .culture-card::after {
      content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
      background: var(--color-orange);
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.4s ease;
    }
    .culture-card:hover::after { transform: scaleX(1); }
    .culture-icon { font-size: 28px; margin-bottom: 14px; display: block; }
    @media (min-width: 768px) {
      .culture-icon { font-size: 36px; }
    }
    .culture-date {
      font: 600 11px/1 var(--font-body); color: var(--color-orange);
      text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px;
    }
    .culture-title {
      font: 700 18px/1.3 var(--font-display); color: var(--color-white);
      margin-bottom: 10px;
    }
    .culture-body {
      font: 400 14px/1.7 var(--font-body); color: var(--color-text-muted);
    }
    .culture-link {
      display: inline-flex; align-items: center; gap: 6px;
      font: 600 12px/1 var(--font-body); color: var(--color-orange);
      margin-top: 14px; transition: gap 0.25s;
    }
    .culture-link:hover { gap: 10px; }
    .culture-card-bg {
      position: absolute; inset: 0; opacity: 0.08;
      background-size: cover; background-position: center;
    }
    .culture-card-bg-overlay {
      position: absolute; inset: 0;
      background: rgba(13, 27, 42, 0.75);
    }
    .culture-card > *:not(.culture-card-bg):not(.culture-card-bg-overlay) {
      position: relative; z-index: 1;
    }

    /* ===== ABCD REPORTS ===== */
    #reports { background: var(--color-navy-mid); }
    .reports-desc {
      font: 400 15px/1.7 var(--font-body);
      color: var(--color-text-muted);
      margin-bottom: 32px; max-width: 720px;
    }
    .abcd-scroll-container {
      display: flex; gap: 20px; overflow-x: auto;
      scroll-snap-type: x mandatory; padding-bottom: 16px;
      scrollbar-width: none; -ms-overflow-style: none;
    }
    .abcd-scroll-container::-webkit-scrollbar { display: none; }
    .abcd-card {
      min-width: 280px; padding: 24px 20px;
      background: var(--color-navy-light);
      border: 1px solid var(--color-divider);
      border-radius: var(--radius-card);
      flex-shrink: 0; scroll-snap-align: start;
    }
    @media (min-width: 768px) {
      .abcd-card { min-width: 320px; padding: 32px 28px; }
    }
    .abcd-sprint-label {
      font: 700 11px/1 var(--font-display);
      color: var(--color-orange); text-transform: uppercase;
      letter-spacing: 0.1em; margin-bottom: 14px;
    }
    .abcd-achievement {
      font: 600 15px/1.4 var(--font-display); color: var(--color-white);
      margin-bottom: 10px;
    }
    .abcd-benefit {
      font: 400 13px/1.6 var(--font-body); color: var(--color-text-muted);
      margin-bottom: 12px;
    }
    .abcd-concern {
      font: 400 13px/1.5 var(--font-body); color: rgba(255, 122, 26, 0.6);
      font-style: italic;
    }

    /* ===== FOOTER ===== */
    footer {
      padding: 60px 0 40px; text-align: center;
      border-top: 1px solid var(--color-divider);
    }
    .footer-avatar {
      width: 56px; height: 56px; border-radius: 50%;
      object-fit: cover; border: 2px solid var(--color-orange);
      margin: 0 auto 16px;
    }
    .footer-avatar-monogram {
      width: 56px; height: 56px; border-radius: 50%;
      background: var(--color-orange); color: var(--color-white);
      font: 700 22px/1 var(--font-display);
      display: none; align-items: center; justify-content: center;
      margin: 0 auto 16px;
    }
    .footer-name {
      font: 700 22px/1.3 var(--font-display); color: var(--color-white);
      margin-bottom: 6px;
    }
    .footer-role {
      font: 400 14px/1.4 var(--font-body); color: var(--color-text-muted);
      margin-bottom: 24px;
    }
    .footer-divider {
      width: 60px; height: 1px; background: var(--color-divider);
      margin: 0 auto 24px;
    }
    .footer-tagline {
      font: 600 15px/1 var(--font-display); color: var(--color-orange);
      margin-bottom: 8px;
    }
    .footer-date {
      font: 400 13px/1 var(--font-body); color: var(--color-text-muted);
    }

    /* ===== RESPONSIVE UTILITIES ===== */
    @media (min-width: 1280px) {
      .container { padding: 0 40px; }
    }
  </style>
</head>
<body>

  <!-- ===== NAV ===== -->
  <nav id="nav">
    <div class="nav-inner">
      <div class="nav-left">
        <img src="https://media.licdn.com/dms/image/v2/D5603AQG5X1p3Z4y-Kw/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1727863581815?e=1749686400&v=beta&t=0ZJasB1aQVPIFx9lyWWmQ41mF8HgKLITqNoqK_OI1qQ" alt="Amir Jamal Ali Khan"
          onerror="this.style.display='none'; document.getElementById('nav-monogram').style.display='flex';"
          class="nav-avatar-img" />
        <div id="nav-monogram" class="nav-avatar-monogram">JA</div>
      </div>
      <div class="nav-links">
